#!/bin/sh
# Mac mini 模式命令列 / Mac mini Mode command line
#   macminimode            檢視狀態 / show status
#   macminimode auto|on|off  切換模式 / switch mode
#   macminimode log [N]    最近 N 行日誌 / last N log lines
#   macminimode check      檢查並輸出診斷資訊 / health check and diagnostics
#   macminimode screen-on  開蓋後螢幕仍是黑的時，把背光開啟 / turn the backlight back on
# 快捷指令裡用「執行 Shell 指令碼」呼叫即可。In Shortcuts, call it from "Run Shell Script".

PREFIX=${MACMINIMODE_PREFIX:-com.macminimode}
APP=/Applications/MacMiniMode.app
LOG=/var/log/macmini-mode.log

status() {
    mode=$(/usr/bin/notifyutil -g "$PREFIX.state" 2>/dev/null | awk '{print $2}')
    case "$mode" in
        1) mode="插電或用電池都不睡眠 always on" ;;
        2) mode="照系統設定睡眠 always off" ;;
        *) mode="插電時不睡眠 automatic" ;;
    esac
    if /usr/bin/pgrep -x macmini-moded >/dev/null; then daemon="執行中 running"; else daemon="未執行 not running"; mode="-"; fi
    if /usr/bin/pmset -g | grep -q "SleepDisabled[[:space:]]*1"; then awake="開啟 on（合蓋繼續執行 stays awake with the lid closed）"; else awake="關閉 off（正常睡眠 sleeps normally）"; fi
    power=$(/usr/bin/pmset -g ps | head -n 1 | sed "s/.*'\(.*\)'.*/\1/")
    battery=$(/usr/bin/pmset -g ps | grep -o '[0-9]*%' | head -n 1)
    version=$(/usr/bin/defaults read "$APP/Contents/Info" CFBundleShortVersionString 2>/dev/null)
    echo "Mac mini 模式 Mode:   $awake"
    echo "設定 Setting:         $mode"
    echo "供電 Power:           $power ${battery}"
    echo "背景服務 Service:     $daemon"
    echo "版本 Version:         ${version:-?}"
}

case "${1:-status}" in
    status) status ;;
    auto|on|off)
        if ! /usr/bin/pgrep -x macmini-moded >/dev/null; then
            echo "背景服務未執行，無法切換 / The background service is not running" >&2
            exit 1
        fi
        /usr/bin/notifyutil -p "$PREFIX.set-$1"
        sleep 1
        status
        ;;
    log) /usr/bin/tail -n "${2:-30}" "$LOG" ;;
    check) "$APP/Contents/MacOS/MacMiniMode" --print-diagnostics ;;
    screen-on)
        if "$APP/Contents/MacOS/MacMiniMode" --screen-on; then
            echo "螢幕背光已開啟 / Backlight is on"
        else
            echo "沒能開啟背光，請按鍵盤上的亮度增加鍵（F2）/ Could not set the backlight; press the brightness-up key (F2)" >&2
            exit 1
        fi
        ;;
    *)
        echo "用法 Usage: macminimode [status|auto|on|off|log [N]|check|screen-on]" >&2
        exit 2
        ;;
esac

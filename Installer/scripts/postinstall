#!/bin/bash
# 啟動守護程序，併為當前登入使用者拉起選單欄圖示（其他使用者下次登入時自動啟動）。

CONSOLE_UID=$(stat -f %u /dev/console)

launchctl bootstrap system /Library/LaunchDaemons/com.macminimode.daemon.plist

# 命令列入口。用軟連結而不是把檔案裝進 /usr/local/bin，免得安裝器改動那個目錄的許可權。
# 那裡已經有一個不是我們的同名檔案時不去碰它。
CLI=/usr/local/bin/macminimode
mkdir -p /usr/local/bin
if [ -L "$CLI" ] || [ ! -e "$CLI" ]; then
    ln -sf /Applications/MacMiniMode.app/Contents/Resources/macminimode "$CLI"
fi
if [ "$CONSOLE_UID" != "0" ]; then
    launchctl bootstrap "gui/$CONSOLE_UID" /Library/LaunchAgents/com.macminimode.menubar.plist
fi

exit 0
